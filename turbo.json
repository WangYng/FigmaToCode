{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/backend/src/**",
        "$TURBO_ROOT$/packages/plugin-ui/src/**",
        "$TURBO_ROOT$/packages/types/src/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx",
        ".eslintrc.js"
      ]
    },
    "type-check": {}
  }
}
